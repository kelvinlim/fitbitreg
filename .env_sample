# This file is read by the program to initialize parameters.
# It can also be sourced in the shell to initialize environment variables.
# This can be done to initialize environment variables when building
# the docker container
# set +a # automatically export all variables
# source .env
# set -a
# Edit the necessary items and then make a copy named .env

db_user=garminuser
db_pw="5bx8"
db_host=lnpiapp.med.umn.edu
db_name=garmindb
db_port=3306
db_dialect=mysql+pymysql
tz=US/Central

# proxies
proxy_http=ahcgate.ahc.umn.edu:3128
proxy_https=ahcgate.ahc.umn.edu:3128

APP_PATH=/fitbitrec

CLIENT_ID=23R
CLIENT_SECRET=65d2
REDIRECT_URI=https://lnpiapp2.med.umn.edu/fitbitrec/callback
# use for testing
#REDIRECT_URI=http://localhost:5000/fitbitrec/callback

AUTHORIZATION_URL = 'https://www.fitbit.com/oauth2/authorize'
TOKEN_URL = 'https://api.fitbit.com/oauth2/token'
SECRET_KEY=top_secret_key_

# Primary key of the Fitbit row in the garmin_wearable table.
# Confirm against `SELECT id, label FROM garmin_wearable;` in the live DB.
FITBIT_WEARABLE_ID=2
